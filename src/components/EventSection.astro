---
// src/components/EventSection.astro
---

<section id="acara" class="py-16 sm:py-24 px-4 bg-gradient-to-b from-[#FAF6ED] via-white to-[#FAF6ED]">
  <div class="max-w-4xl mx-auto text-center space-y-12">
    
    <!-- Section Header -->
    <div class="space-y-2">
      <span class="text-xs uppercase tracking-[0.3em] text-[#8C6D53] font-bold">Waktu & Tempat</span>
      <h2 class="font-serif-wedding text-3xl sm:text-5xl text-[#4A3525] font-semibold">Rangkaian Acara Pernikahan</h2>
      <div class="w-20 h-0.5 bg-gradient-to-r from-transparent via-[#8C6D53] to-transparent mx-auto"></div>
    </div>

    <!-- Event Cards Grid -->
    <div class="grid md:grid-cols-2 gap-8 pt-4">
      
      <!-- Akad Nikah Card -->
      <div class="p-8 rounded-3xl bg-white border border-[#E5DCC5] shadow-lg shadow-[#6E4F38]/5 space-y-5 text-center flex flex-col justify-between hover:border-[#8C6D53]/40 transition-colors">
        <div class="space-y-4">
          <div class="w-14 h-14 rounded-2xl bg-[#FAF6ED] border border-[#E5DCC5] mx-auto flex items-center justify-center text-[#7A5C43]">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <div>
            <h3 class="font-serif-wedding text-3xl text-[#4A3525] font-bold">Akad Nikah</h3>
            <p class="text-xs text-[#8C6D53] font-semibold tracking-wider uppercase mt-1">Sabtu, 12 Desember 2026</p>
          </div>

          <div class="w-16 h-px bg-[#E5DCC5] mx-auto"></div>

          <div class="space-y-2 text-sm text-[#594433]">
            <p class="font-semibold text-[#4A3525]">🕒 Pukul 08:00 - 10:00 WIB</p>
            <p class="font-medium">📍 Masjid Agung Central City</p>
            <p class="text-xs text-[#7A5C43] max-w-xs mx-auto leading-relaxed font-light">
              Jl. Nusantara Utama No. 45, Kompleks Kebayoran, Jakarta Selatan
            </p>
          </div>
        </div>

        <div class="pt-4">
          <a 
            href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Akad+Nikah+Adam+%26+Hawa&dates=20261212T010000Z/20261212T030000Z&details=Akad+Nikah+Adam+%26+Hawa&location=Masjid+Agung+Central" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#FAF6ED] hover:bg-[#EFE6D5] text-[#6E4F38] text-xs font-semibold border border-[#E5DCC5] transition-all duration-300 hover:scale-105 shadow-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <span>Simpan Tanggal (Google Calendar)</span>
          </a>
        </div>
      </div>

      <!-- Resepsi Pernikahan Card -->
      <div class="p-8 rounded-3xl bg-white border border-[#E5DCC5] shadow-lg shadow-[#6E4F38]/5 space-y-5 text-center flex flex-col justify-between hover:border-[#8C6D53]/40 transition-colors">
        <div class="space-y-4">
          <div class="w-14 h-14 rounded-2xl bg-[#FAF6ED] border border-[#E5DCC5] mx-auto flex items-center justify-center text-[#7A5C43]">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 0v-4a1 1 0 011-1h2a1 1 0 011 1v4"/>
            </svg>
          </div>
          <div>
            <h3 class="font-serif-wedding text-3xl text-[#4A3525] font-bold">Resepsi Pernikahan</h3>
            <p class="text-xs text-[#8C6D53] font-semibold tracking-wider uppercase mt-1">Sabtu, 12 Desember 2026</p>
          </div>

          <div class="w-16 h-px bg-[#E5DCC5] mx-auto"></div>

          <div class="space-y-2 text-sm text-[#594433]">
            <p class="font-semibold text-[#4A3525]">🕒 Pukul 11:00 - 14:00 WIB</p>
            <p class="font-medium">📍 Grand Ballroom Hotel Grand Palace</p>
            <p class="text-xs text-[#7A5C43] max-w-xs mx-auto leading-relaxed font-light">
              Jl. Jendral Sudirman Kav. 88, Senayan, Jakarta Selatan
            </p>
          </div>
        </div>

        <div class="pt-4">
          <a 
            href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Resepsi+Pernikahan+Adam+%26+Hawa&dates=20261212T040000Z/20261212T070000Z&details=Resepsi+Pernikahan+Adam+%26+Hawa&location=Grand+Ballroom+Hotel+Grand+Palace" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#FAF6ED] hover:bg-[#EFE6D5] text-[#6E4F38] text-xs font-semibold border border-[#E5DCC5] transition-all duration-300 hover:scale-105 shadow-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <span>Simpan Tanggal (Google Calendar)</span>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
