---
// src/components/CoupleSection.astro
interface Props {
  groomName?: string;
  brideName?: string;
}

const { groomName = "Adam", brideName = "Hawa" } = Astro.props;
---

<section id="mempelai" class="py-16 sm:py-24 px-4 bg-[#FAF6ED] relative">
  <div class="max-w-4xl mx-auto text-center space-y-12">
    
    <!-- Section Header -->
    <div class="space-y-2">
      <span class="text-xs uppercase tracking-[0.3em] text-[#8C6D53] font-bold">Pasangan Mempelai</span>
      <h2 class="font-serif-wedding text-3xl sm:text-5xl text-[#4A3525] font-semibold">Mempelai Pria & Wanita</h2>
      <div class="w-20 h-0.5 bg-gradient-to-r from-transparent via-[#8C6D53] to-transparent mx-auto"></div>
    </div>

    <!-- Couple Cards Grid -->
    <div class="grid md:grid-cols-2 gap-8 items-center pt-4">
      
      <!-- Groom Card -->
      <div class="p-8 sm:p-10 rounded-3xl bg-white border border-[#E5DCC5] shadow-lg shadow-[#6E4F38]/5 space-y-4 hover:shadow-xl transition-all duration-300 group">
        <!-- Avatar Initial Badge -->
        <div class="w-24 h-24 rounded-full bg-[#FAF6ED] border-2 border-[#8C6D53]/40 mx-auto flex items-center justify-center text-[#7A5C43] font-serif-wedding text-4xl font-bold group-hover:scale-105 transition-transform duration-300 shadow-inner">
          A
        </div>
        <div>
          <span class="text-xs text-[#8C6D53] font-semibold tracking-widest uppercase block mb-1">Mempelai Pria</span>
          <h3 class="font-serif-wedding text-3xl sm:text-4xl text-[#4A3525] font-bold">{groomName} Putra</h3>
        </div>
        <div class="w-12 h-px bg-[#E5DCC5] mx-auto my-2"></div>
        <div class="space-y-1">
          <p class="text-xs text-[#7A5C43] font-semibold uppercase tracking-wider">Putra Pertama Dari</p>
          <p class="text-sm text-[#594433] font-medium">Bpk. H. Ahmad & Ibu Hj. Aminah</p>
        </div>
        <!-- Instagram Tag -->
        <div class="pt-2">
          <a 
            href="https://instagram.com" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-[#FAF6ED] hover:bg-[#EFE6D5] text-[#6E4F38] text-xs font-medium border border-[#E5DCC5] transition-colors"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>@adam_official</span>
          </a>
        </div>
      </div>

      <!-- Bride Card -->
      <div class="p-8 sm:p-10 rounded-3xl bg-white border border-[#E5DCC5] shadow-lg shadow-[#6E4F38]/5 space-y-4 hover:shadow-xl transition-all duration-300 group">
        <!-- Avatar Initial Badge -->
        <div class="w-24 h-24 rounded-full bg-[#FAF6ED] border-2 border-[#8C6D53]/40 mx-auto flex items-center justify-center text-[#7A5C43] font-serif-wedding text-4xl font-bold group-hover:scale-105 transition-transform duration-300 shadow-inner">
          H
        </div>
        <div>
          <span class="text-xs text-[#8C6D53] font-semibold tracking-widest uppercase block mb-1">Mempelai Wanita</span>
          <h3 class="font-serif-wedding text-3xl sm:text-4xl text-[#4A3525] font-bold">{brideName} Putri</h3>
        </div>
        <div class="w-12 h-px bg-[#E5DCC5] mx-auto my-2"></div>
        <div class="space-y-1">
          <p class="text-xs text-[#7A5C43] font-semibold uppercase tracking-wider">Putri Pertama Dari</p>
          <p class="text-sm text-[#594433] font-medium">Bpk. H. Hasan & Ibu Hj. Khadijah</p>
        </div>
        <!-- Instagram Tag -->
        <div class="pt-2">
          <a 
            href="https://instagram.com" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-[#FAF6ED] hover:bg-[#EFE6D5] text-[#6E4F38] text-xs font-medium border border-[#E5DCC5] transition-colors"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>@hawa_official</span>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
