---
// src/components/CoupleSection.astro
interface Props {
  groomName?: string;
  brideName?: string;
  groomPhoto?: string;
  bridePhoto?: string;
}

const { 
  groomName = "Arik", 
  brideName = "Monica",
  groomPhoto = "/image/pria.jpg",
  bridePhoto = "/image/wanita.jpg"
} = Astro.props;
---

<section id="mempelai" class="py-16 sm:py-24 px-4 bg-gradient-to-b from-[#F7EFE2]/80 via-[#FAF4EA]/85 to-[#F2E6D4]/80 relative overflow-hidden">
  <!-- Background Ornaments -->
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-[#8C6D53]/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-[#8C6D53]/5 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Floating Corner Ornaments (Pojok Layar / Screen Corners) -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden select-none z-0">
    <!-- Sudut Kiri Atas -->
    <span class="absolute -top-3 -left-3" data-aos="zoom-in" data-aos-delay="0">
      <img src="/image/sudut_bunga.png" alt="Dekorasi Bunga Kiri Atas"
        class="w-32 sm:w-48 md:w-60 lg:w-72 h-auto object-contain drop-shadow-md opacity-90 pointer-events-none select-none" />
    </span>
    <!-- Sudut Kanan Atas -->
    <span class="absolute -top-3 -right-3" data-aos="zoom-in" data-aos-delay="100">
      <img src="/image/sudut_bunga.png" alt="Dekorasi Bunga Kanan Atas"
        class="w-32 sm:w-48 md:w-60 lg:w-72 h-auto object-contain drop-shadow-md opacity-90 scale-x-[-1] pointer-events-none select-none" />
    </span>

    <!-- Sudut Kiri Bawah Layar (Layered Bouquet) -->
    <div class="absolute -bottom-3 -left-3 pointer-events-none select-none z-0">
      <!-- 1. Paling Pojok (Outer Corner): tangkai_bunga_2.png (BEHIND sudut_bunga) -->
      <span class="absolute bottom-0 left-0 z-0" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="0">
        <img src="/image/tangkai_bunga_2.png" alt="Tangkai Bunga 2" class="w-32 sm:w-44 md:w-56 h-auto object-contain animate-sway drop-shadow-sm" />
      </span>

      <!-- 2. Bergeser ke Tengah: tangkai_bunga_3.png (BEHIND sudut_bunga) -->
      <span class="absolute bottom-2 left-16 sm:left-24 md:left-32 z-1" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="100">
        <img src="/image/tangkai_bunga_3.png" alt="Tangkai Bunga 3" class="w-28 sm:w-40 md:w-52 h-auto object-contain animate-sway drop-shadow-sm" />
      </span>

      <!-- 3. Lebih ke Tengah: satu_bunga_2.png (BEHIND sudut_bunga) -->
      <span class="absolute bottom-6 left-36 sm:left-52 md:left-64 z-2" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="200">
        <img src="/image/satu_bunga_2.png" alt="Satu Bunga 2" class="w-16 sm:w-22 md:w-28 h-auto object-contain animate-sway drop-shadow-md" />
      </span>

      <!-- 4. Paling Tengah: satu_bunga.png (BEHIND sudut_bunga) -->
      <span class="absolute bottom-10 left-52 sm:left-72 md:left-88 z-3" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="300">
        <img src="/image/satu_bunga.png" alt="Satu Bunga" class="w-18 sm:w-24 md:w-30 h-auto object-contain animate-sway drop-shadow-md" />
      </span>

      <!-- FRONT LAYER: sudut_bunga.png (Di Depan Semua Tangkai & Bunga) -->
      <span class="relative block z-10" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="0">
        <img 
          src="/image/sudut_bunga.png" 
          alt="Dekorasi Bunga Kiri Bawah" 
          class="w-36 sm:w-52 md:w-64 lg:w-80 h-auto object-contain drop-shadow-md opacity-95 scale-y-[-1]"
        />
      </span>
    </div>

    <!-- Sudut Kanan Bawah Layar (Layered Bouquet) -->
    <div class="absolute -bottom-3 -right-3 pointer-events-none select-none z-0">
      <!-- 1. Paling Pojok (Outer Corner): tangkai_bunga_2.png (BEHIND sudut_bunga) -->
      <span class="absolute bottom-0 right-0 z-0" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="0">
        <img src="/image/tangkai_bunga_2.png" alt="Tangkai Bunga 2" class="w-32 sm:w-44 md:w-56 h-auto object-contain animate-sway drop-shadow-sm scale-x-[-1]" />
      </span>

      <!-- 2. Bergeser ke Tengah: tangkai_bunga_3.png (BEHIND sudut_bunga) -->
      <span class="absolute bottom-2 right-16 sm:right-24 md:right-32 z-1" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="100">
        <img src="/image/tangkai_bunga_3.png" alt="Tangkai Bunga 3" class="w-28 sm:w-40 md:w-52 h-auto object-contain animate-sway drop-shadow-sm scale-x-[-1]" />
      </span>

      <!-- 3. Lebih ke Tengah: satu_bunga_2.png (BEHIND sudut_bunga) -->
      <span class="absolute bottom-6 right-36 sm:right-52 md:right-64 z-2" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="200">
        <img src="/image/satu_bunga_2.png" alt="Satu Bunga 2" class="w-16 sm:w-22 md:w-28 h-auto object-contain animate-sway drop-shadow-md scale-x-[-1]" />
      </span>

      <!-- 4. Paling Tengah: satu_bunga.png (BEHIND sudut_bunga) -->
      <span class="absolute bottom-10 right-52 sm:right-72 md:right-88 z-3" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="300">
        <img src="/image/satu_bunga.png" alt="Satu Bunga" class="w-18 sm:w-24 md:w-30 h-auto object-contain animate-sway drop-shadow-md scale-x-[-1]" />
      </span>

      <!-- FRONT LAYER: sudut_bunga.png (Di Depan Semua Tangkai & Bunga) -->
      <span class="relative block z-10" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="0">
        <img 
          src="/image/sudut_bunga.png" 
          alt="Dekorasi Bunga Kanan Bawah" 
          class="w-36 sm:w-52 md:w-64 lg:w-80 h-auto object-contain drop-shadow-md opacity-95 scale-x-[-1] scale-y-[-1]"
        />
      </span>
    </div>
  </div>

  <div class="max-w-6xl mx-auto text-center space-y-10 sm:space-y-12 relative z-10">
    
    <!-- Section Header -->
    <div class="space-y-3 max-w-2xl mx-auto">
      <span class="text-xs uppercase tracking-[0.35em] text-[#8C6D53] font-bold block">Undangan Pernikahan</span>
      <h2 class="font-serif-wedding text-3xl sm:text-5xl text-[#4A3525] font-semibold">
        Acara Pernikahan
      </h2>
      <div class="w-24 h-0.5 bg-gradient-to-r from-transparent via-[#8C6D53]/60 to-transparent mx-auto my-2"></div>
      
      <!-- Date & Location -->
      <p class="font-bold text-[#4A3525] text-sm sm:text-base pt-1">
        Diselenggarakan pada Rabu, 15 November 2026 di Kota Malang, Jawa Timur.
      </p>
      <p class="text-[#594433] text-xs sm:text-sm max-w-xl mx-auto leading-relaxed font-normal opacity-90">
        Dengan memohon Rahmat & Ridho Allah SWT, kami bermaksud untuk mengundang Bapak/Ibu, Saudara/i untuk hadir pada acara pernikahan anak kami
      </p>
    </div>

    <!-- UNIFIED RESPONSIVE COUPLE CONTAINER -->
    <div class="flex flex-col md:flex-row items-center justify-center gap-6 md:gap-4 lg:gap-8 max-w-5xl mx-auto py-4">
      
      <!-- Groom Section (Text di Kiri, Avatar di Kanan) -->
      <div class="flex items-center justify-end gap-5 sm:gap-8 lg:gap-10 w-full md:w-auto text-right min-w-0">
        <!-- Groom Text -->
        <div class="flex-1 md:flex-initial space-y-1 min-w-0 pr-2 sm:pr-4 lg:pr-6">
          <h3 class="font-script text-xl sm:text-2xl md:text-3xl lg:text-4xl text-[#7A5C43] font-normal leading-snug whitespace-nowrap">
            {groomName} Wahyu Pratama
          </h3>
          <p class="text-[11px] sm:text-xs lg:text-sm text-[#594433] leading-relaxed font-medium">
            Putra Pertama dari Bpk. Imam Basori <br />dan Ibu Syarifatun
          </p>
        </div>

        <!-- Groom Avatar / Photo Frame Container -->
        <div class="relative shrink-0 flex items-center justify-center my-2">
          <!-- Background Flower Frame (bunga_bingkai.png) - BEHIND photo frame (z-0) -->
          <span class="absolute inset-0 -m-5 sm:-m-7 lg:-m-9 pointer-events-none z-0 flex items-center justify-center" data-aos="zoom-in" data-aos-duration="1800">
            <img 
              src="/image/bunga_bingkai.png" 
              alt="Bingkai Bunga" 
              class="w-[155%] h-[155%] max-w-none object-contain animate-sway pointer-events-none select-none drop-shadow-sm" 
            />
          </span>

          <!-- Main Photo Frame (z-10) -->
          <div class="w-20 h-20 sm:w-24 sm:h-24 lg:w-32 lg:h-32 rounded-full bg-gradient-to-b from-[#FAF6ED] to-[#F5EBD9] border-4 border-white shadow-md flex items-center justify-center text-[#7A5C43] font-serif-wedding text-2xl sm:text-3xl lg:text-4xl font-bold overflow-hidden relative z-10">
            <img 
              src={groomPhoto} 
              alt={`Foto ${groomName}`} 
              class="w-full h-full object-cover"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <span class="hidden w-full h-full items-center justify-center">{groomName ? groomName.charAt(0) : "A"}</span>
          </div>

          <!-- Foreground Flower (bunga_depan.png) - IN FRONT of photo frame (z-20) at bottom tip of frame -->
          <span class="absolute -bottom-6 sm:-bottom-8 lg:-bottom-10 left-1/2 -translate-x-1/2 pointer-events-none z-20 w-16 sm:w-20 lg:w-26 flex justify-center" data-aos="zoom-in" data-aos-duration="2000">
            <img 
              src="/image/bunga_depan.png" 
              alt="Bunga Depan Frame" 
              class="w-full h-auto object-contain drop-shadow-md pointer-events-none select-none" 
            />
          </span>
        </div>
      </div>

      <!-- Small Heart Badge (Desktop Only) -->
      <div class="hidden md:flex w-9 h-9 lg:w-10 lg:h-10 rounded-full bg-white border border-[#E5DCC5] shadow-md items-center justify-center text-[#8C6D53] shrink-0 -mx-3 lg:-mx-4 z-20">
        <svg class="w-4 h-4 lg:w-5 lg:h-5 text-[#8C6D53] fill-current" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </div>

      <!-- Bride Section (Avatar di Kiri, Text di Kanan) -->
      <div class="flex items-center justify-start gap-5 sm:gap-8 lg:gap-10 w-full md:w-auto text-left min-w-0">
        <!-- Bride Avatar / Photo Frame Container -->
        <div class="relative shrink-0 flex items-center justify-center my-2">
          <!-- Background Flower Frame (bunga_bingkai.png) - BEHIND photo frame (z-0) -->
          <span class="absolute inset-0 -m-5 sm:-m-7 lg:-m-9 pointer-events-none z-0 flex items-center justify-center" data-aos="zoom-in" data-aos-duration="1800">
            <img 
              src="/image/bunga_bingkai.png" 
              alt="Bingkai Bunga" 
              class="w-[155%] h-[155%] max-w-none object-contain animate-sway pointer-events-none select-none scale-x-[-1] drop-shadow-sm" 
            />
          </span>

          <!-- Main Photo Frame (z-10) -->
          <div class="w-20 h-20 sm:w-24 sm:h-24 lg:w-32 lg:h-32 rounded-full bg-gradient-to-b from-[#FAF6ED] to-[#F5EBD9] border-4 border-white shadow-md flex items-center justify-center text-[#7A5C43] font-serif-wedding text-2xl sm:text-3xl lg:text-4xl font-bold overflow-hidden relative z-10">
            <img 
              src={bridePhoto} 
              alt={`Foto ${brideName}`} 
              class="w-full h-full object-cover"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <span class="hidden w-full h-full items-center justify-center">{brideName ? brideName.charAt(0) : "M"}</span>
          </div>

          <!-- Foreground Flower (bunga_depan.png) - IN FRONT of photo frame (z-20) at bottom tip of frame -->
          <span class="absolute -bottom-6 sm:-bottom-8 lg:-bottom-10 left-1/2 -translate-x-1/2 pointer-events-none z-20 w-16 sm:w-20 lg:w-26 flex justify-center" data-aos="zoom-in" data-aos-duration="2000">
            <img 
              src="/image/bunga_depan.png" 
              alt="Bunga Depan Frame" 
              class="w-full h-auto object-contain drop-shadow-md pointer-events-none select-none scale-x-[-1]" 
            />
          </span>
        </div>

        <!-- Bride Text -->
        <div class="flex-1 md:flex-initial space-y-1 min-w-0 pl-2 sm:pl-4 lg:pl-6">
          <h3 class="font-script text-xl sm:text-2xl md:text-3xl lg:text-4xl text-[#7A5C43] font-normal leading-snug whitespace-nowrap">
            Monica Ramadhaniyah
          </h3>
          <p class="text-[11px] sm:text-xs lg:text-sm text-[#594433] leading-relaxed font-medium">
            Putri dari Ust. H. Syamsul Huda <br />dan Ning Hj. Nikmatuz Zuhriyah
          </p>
        </div>
      </div>

    </div>

    <!-- Surah Section (Di Bawah Mempelai) -->
    <div class="space-y-6 pt-6 max-w-3xl mx-auto">
      <p class="text-[#594433] text-xs sm:text-sm max-w-xl mx-auto leading-relaxed font-normal opacity-90">
        Yang akan diselenggarakan pada <strong class="font-bold text-[#4A3525]">Rabu, 15 November 2026</strong> di <strong class="font-bold text-[#4A3525]">Pondok Pesantren Anwarul Huda Kota Malang, Jawa Timur</strong>
      </p>
      
      <div class="flex justify-center items-center gap-3 text-[#8C6D53]">
        <div class="h-px w-12 bg-gradient-to-r from-transparent to-[#8C6D53]"></div>
        <svg class="w-6 h-6 text-[#7A5C43] fill-current" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
        <div class="h-px w-12 bg-gradient-to-l from-transparent to-[#8C6D53]"></div>
      </div>

      <div class="p-6 sm:p-10 rounded-3xl bg-white/95 backdrop-blur-sm border border-[#E5DCC5] shadow-xl shadow-[#6E4F38]/10 space-y-6 relative overflow-hidden">
        <!-- Card Corner Ornaments (Clean & Unobtrusive) -->
        <span class="absolute -top-4 -left-4 z-10" data-aos="zoom-in">
          <img src="/image/sudut_bunga.png" alt="Ornamen Bunga" class="w-24 sm:w-32 h-auto opacity-70 pointer-events-none select-none" />
        </span>
        <span class="absolute -bottom-4 -right-4 z-10" data-aos="zoom-in" data-aos-delay="150">
          <img src="/image/sudut_bunga.png" alt="Ornamen Bunga" class="w-24 sm:w-32 h-auto opacity-70 pointer-events-none select-none scale-x-[-1] scale-y-[-1]" />
        </span>

        <!-- Arabic Text -->
        <p class="text-2xl sm:text-3xl text-[#4A3525] font-serif leading-loose text-center dir-rtl font-semibold" style="font-family: 'Traditional Arabic', 'Amiri', serif;">
          وَمِنْ آيَاتِهِ أَنْ خَلَقَ لَكُمْ مِنْ أَنْفُسِكُمْ أَزْوَاجًا لِتَسْكُنُوا إِلَيْهَا وَجَعَلَ بَيْنَكُمْ مَوَدَّةً وَرَحْمَةً ۚ إِنَّ فِي ذَٰلِك لَآيَاتٍ لِقَوْمٍ يَتَفَكَّرُونَ
        </p>

        <div class="w-24 h-px bg-[#E5DCC5] mx-auto"></div>

        <!-- Indonesian Translation -->
        <p class="text-xs sm:text-sm text-[#594433] leading-relaxed italic font-light max-w-xl mx-auto opacity-90">
          "Dan di antara tanda-tanda (kebesaran)-Nya ialah Dia menciptakan pasangan-pasangan untukmu dari mejelismu sendiri, agar kamu cenderung dan merasa tenteram kepadanya, dan Dia menjadikan di antaramu rasa kasih dan sayang. Sungguh, pada yang demikian itu benar-benar terdapat tanda-tanda (kebesaran Allah) bagi kaum yang berpikir."
        </p>
        <span class="text-xs uppercase tracking-[0.3em] text-[#8C6D53] font-bold block">QS. Ar-Rum : 21</span>
      </div>
    </div>

  </div>
</section>

