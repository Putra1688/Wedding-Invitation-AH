---
// src/components/FooterSection.astro
interface Props {
  groomName?: string;
  brideName?: string;
}

const { groomName = "Adam", brideName = "Hawa" } = Astro.props;
---

<footer class="py-16 px-4 bg-[#F4EBD9]/85 border-t border-[#E5DCC5] text-center space-y-8 relative overflow-hidden">
  
  <div class="max-w-2xl mx-auto space-y-4">
    <!-- Heart Symbol -->
    <div class="w-12 h-12 rounded-full bg-white border border-[#E5DCC5] mx-auto flex items-center justify-center text-[#7A5C43] shadow-sm">
      <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
      </svg>
    </div>

    <!-- Expression of Gratitude -->
    <p class="text-xs sm:text-sm text-[#594433] leading-relaxed font-light italic">
      Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir untuk memberikan doa restu kepada kedua mempelai.
    </p>

    <!-- Closing Salam -->
    <p class="text-xs text-[#7A5C43] font-semibold tracking-wider uppercase">
      Wassalamu’alaikum Warahmatullahi Wabarakatuh
    </p>

    <!-- Family Signature -->
    <div class="pt-4 space-y-1">
      <p class="text-xs text-[#8C6D53] font-medium">Kami yang berbahagia,</p>
      <h3 class="font-serif-wedding text-3xl sm:text-4xl text-[#4A3525] font-bold">
        Keluarga Besar {groomName} & {brideName}
      </h3>
    </div>
  </div>

  <div class="w-full h-px bg-[#E5DCC5] max-w-md mx-auto"></div>

  <!-- Copyright Credit Line -->
  <div class="text-[11px] text-[#8C6D53] space-y-1 font-light">
    <p>© 2026 Undangan Pernikahan {groomName} & {brideName}. All Rights Reserved.</p>
    <p class="text-[#7A5C43]">Dibuat dengan 🤍 untuk momen kebahagiaan kami.</p>
  </div>
</footer>
