---
// src/components/CoverSection.astro
interface Props {
  groomName: string;
  brideName: string;
}

const { groomName, brideName } = Astro.props;
---

<section 
  id="cover-screen" 
  class="fixed inset-0 z-40 flex flex-col items-center justify-between p-4 sm:p-6 md:p-8 text-center overflow-y-auto transition-all duration-1000 ease-in-out bg-gradient-to-b from-[#F7EFE2]/90 via-[#EFE2CC]/85 to-[#E4D4B7]/90 backdrop-blur-sm border-b border-[#8C6D53]/30"
>
  <!-- Background glows -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-white/70 via-transparent to-transparent pointer-events-none"></div>
  <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#8C6D53]/10 via-transparent to-transparent pointer-events-none"></div>

  <!-- Ornate Outer Frame -->
  <div class="absolute inset-3 sm:inset-5 border border-[#8C6D53]/25 rounded-2xl sm:rounded-3xl pointer-events-none flex flex-col justify-between p-2 sm:p-3">
    <div class="flex justify-between items-center text-[#8C6D53]/40 text-xs">
      <span>✦</span><span>✦</span>
    </div>
    <div class="flex justify-between items-center text-[#8C6D53]/40 text-xs">
      <span>✦</span><span>✦</span>
    </div>
  </div>

  <!-- ── FLOATING FLOWER DECORATIONS (tangkai & aksen — sudut dipindah ke Layout) ── -->

  <!-- Tangkai kiri tengah -->
  <img src="/image/tangkai_bunga.png" alt=""
    class="flower-stalk-l absolute -left-4 top-1/3 w-24 sm:w-32 h-auto opacity-75 pointer-events-none select-none"
    style="animation-delay:0.4s" />

  <!-- Tangkai kanan tengah -->
  <img src="/image/tangkai_bunga.png" alt=""
    class="flower-stalk-r absolute -right-4 top-1/3 w-24 sm:w-32 h-auto opacity-75 pointer-events-none select-none"
    style="animation-delay:0.5s" />

  <!-- Bunga bawah kiri -->
  <img src="/image/bunga_depan.png" alt=""
    class="flower-bot-l absolute bottom-16 sm:bottom-24 left-1 sm:left-4 w-16 sm:w-24 h-auto opacity-80 pointer-events-none select-none"
    style="animation-delay:0.6s" />

  <!-- Bunga bawah kanan -->
  <img src="/image/bunga_depan.png" alt=""
    class="flower-bot-r absolute bottom-16 sm:bottom-24 right-1 sm:right-4 w-16 sm:w-24 h-auto opacity-80 pointer-events-none select-none"
    style="animation-delay:0.7s" />

  <!-- Aksen bunga kecil kiri -->
  <img src="/image/satu_bunga.png" alt=""
    class="flower-sm-l absolute top-[38%] left-3 sm:left-8 w-9 sm:w-12 h-auto opacity-60 pointer-events-none select-none"
    style="animation-delay:0.8s" />

  <!-- Aksen bunga kecil kanan -->
  <img src="/image/satu_bunga.png" alt=""
    class="flower-sm-r absolute top-[38%] right-3 sm:right-8 w-9 sm:w-12 h-auto opacity-60 pointer-events-none select-none"
    style="animation-delay:0.9s" />

  <!-- ── TOP HEADER ── -->
  <div class="relative z-10 pt-1 sm:pt-4 shrink-0 cover-fadein">
    <div class="flex justify-center items-center gap-2 sm:gap-3 text-[#7A5C43] mb-1">
      <div class="h-px w-8 sm:w-12 bg-gradient-to-r from-transparent to-[#8C6D53]"></div>
      <svg class="w-4 h-4 sm:w-5 sm:h-5 text-[#6E4F38] fill-current" viewBox="0 0 24 24">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
      </svg>
      <div class="h-px w-8 sm:w-12 bg-gradient-to-l from-transparent to-[#8C6D53]"></div>
    </div>
    <p class="text-[11px] sm:text-xs md:text-sm tracking-[0.3em] text-[#7A5C43] uppercase font-semibold">
      Undangan Pernikahan
    </p>
  </div>

  <!-- ── CENTER: GREETINGS + NAMES + COUPLE PHOTO ── -->
  <div class="relative z-10 mt-0 mb-16 sm:my-auto flex flex-col items-center gap-1 sm:gap-3 shrink cover-fadein" style="animation-delay:0.15s">

    <!-- Salam & Teks Undangan (Di atas Nama) -->
    <div class="cover-fadein space-y-0.5" style="animation-delay:0.2s">
      <p class="text-[#594433] text-[11px] sm:text-base font-light italic tracking-wider">
        Assalamu’alaikum Wr. Wb.
      </p>
      <p class="text-[#594433] text-[10px] sm:text-sm  mx-auto leading-snug font-light px-2">
        Ya Allah semoga ridho-Mu tercurah mengiringi pernikahan anak kami
      </p>
    </div>

    <!-- Names -->
    <h1 class="font-elegant-serif text-3xl sm:text-5xl md:text-6xl font-semibold text-[#4A3525] tracking-wide leading-tight">
      {groomName}
      <span class="font-script text-[#8C6D53] text-3xl sm:text-5xl md:text-6xl mx-1 sm:mx-2 font-normal">&</span>
      {brideName}
    </h1>

    <!-- Tanggal -->
    <div class="flex justify-center items-center gap-3 text-[#8C6D53]/60">
      <div class="h-px w-12 sm:w-16 bg-gradient-to-r from-transparent to-[#8C6D53]/50"></div>
      <span class="text-[10px] sm:text-xs uppercase tracking-[0.25em] font-semibold text-[#8C6D53]">15 · 11 · 2026</span>
      <div class="h-px w-12 sm:w-16 bg-gradient-to-l from-transparent to-[#8C6D53]/50"></div>
    </div>

    <!-- Couple Photo -->
    <div class="relative w-52 h-52 sm:w-56 sm:h-56 md:w-64 md:h-64 shrink-0 mb-2">
      <!-- Garis bunga bingkai belakang foto -->
      <img src="/image/bunga_bingkai.png" alt=""
        class="flower-deco absolute -top-5 -left-5 w-full h-full object-contain opacity-80 pointer-events-none select-none z-0"
        style="animation-delay:0.5s"
      />
      <!-- Foto couple -->
      <img
        src="/image/couple.png"
        alt={`${groomName} & ${brideName}`}
        class="relative z-10 w-full h-full object-cover rounded-full border-4 border-white shadow-xl shadow-[#6E4F38]/20 cover-fadein"
        style="animation-delay:0.3s"
      />
      <!-- Satu bunga aksen pojok foto -->
      <img src="/image/satu_bunga_2.png" alt=""
        class="flower-deco absolute -bottom-4 -right-4 w-14 sm:w-18 h-auto opacity-90 pointer-events-none select-none z-20"
        style="animation-delay:0.9s"
      />
      <img src="/image/satu_bunga_2.png" alt=""
        class="flower-deco absolute -bottom-4 -left-4 w-14 sm:w-18 h-auto opacity-90 pointer-events-none select-none z-20 scale-x-[-1]"
        style="animation-delay:1s"
      />
    </div>

    <div class="cover-fadein space-y-0.5" style="animation-delay:0.2s">
      <p class="text-[#594433] text-[12px] sm:text-sm max-w-xl mx-auto leading-snug font-light px-6">
        Dengan penuh kebahagiaan & rasa syukur, kami mengundang Bapak/Ibu/Saudara/i untuk hadir memberikan doa restu.
      </p>
    </div>
  </div>

  <!-- ── CTA BUTTON ── -->
  <div class="relative z-10 mt-4 pb-3 sm:pb-4 shrink-0 cover-fadein" style="animation-delay:0.5s">
    <button 
      id="btn-open-invitation"
      class="group relative inline-flex items-center gap-2.5 sm:gap-3 px-6 py-2.5 sm:px-8 sm:py-3.5 rounded-full bg-gradient-to-r from-[#7A5C43] via-[#6E4F38] to-[#593E2B] text-white font-semibold text-xs sm:text-sm tracking-wide shadow-[0_10px_25px_rgba(110,79,56,0.25)] hover:shadow-[0_15px_30px_rgba(110,79,56,0.4)] transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer"
    >
      <svg class="w-4 h-4 sm:w-5 sm:h-5 text-amber-100 transition-transform duration-300 group-hover:rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
      </svg>
      <span>Buka Undangan</span>
      <svg class="w-4 h-4 text-amber-100 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
      </svg>
    </button>
    <p class="text-[10px] sm:text-[11px] text-[#8C6D53] mt-1.5 font-medium">Klik untuk membuka undangan</p>
  </div>

</section>

<style>
  /* ── BASE ZOOM-IN (muncul dari kecil) ── */
  @keyframes zoomIn {
    0%   { opacity: 0; transform: scale(0.3); }
    60%  { opacity: 1; transform: scale(1.08); }
    80%  { transform: scale(0.97); }
    100% { opacity: 1; transform: scale(1); }
  }

  /* ── FLOAT VARIANTS ── */

  /* Normal float: naik-turun + sedikit goyang kanan */
  @keyframes floatNormal {
    0%,100% { transform: translateY(0px)  rotate(0deg);  }
    40%      { transform: translateY(-7px) rotate(1.5deg); }
    70%      { transform: translateY(-3px) rotate(-1deg); }
  }

  /* Mirror-X float: scaleX(-1) dijaga, float ke atas */
  @keyframes floatMirrorX {
    0%,100% { transform: scaleX(-1) translateY(0px)  rotate(0deg);  }
    40%      { transform: scaleX(-1) translateY(-7px) rotate(-1.5deg); }
    70%      { transform: scaleX(-1) translateY(-3px) rotate(1deg); }
  }

  /* Mirror-Y float: scaleY(-1) dijaga */
  @keyframes floatMirrorY {
    0%,100% { transform: scaleY(-1) translateY(0px)  rotate(0deg);  }
    40%      { transform: scaleY(-1) translateY(-7px) rotate(1.5deg); }
    70%      { transform: scaleY(-1) translateY(-3px) rotate(-1deg); }
  }

  /* Mirror-XY float */
  @keyframes floatMirrorXY {
    0%,100% { transform: scaleX(-1) scaleY(-1) translateY(0px); }
    50%      { transform: scaleX(-1) scaleY(-1) translateY(-6px); }
  }

  /* Tangkai kiri: mulai dari sudut kiri miring ke atas (rotate -30deg), float pelan */
  @keyframes floatStalkL {
    0%,100% { transform: rotate(-30deg) translateY(0px); }
    50%      { transform: rotate(-30deg) translateY(-8px); }
  }

  /* Tangkai kanan: mirror tangkai kiri (scaleX + rotate +30deg) */
  @keyframes floatStalkR {
    0%,100% { transform: scaleX(-1) rotate(-30deg) translateY(0px); }
    50%      { transform: scaleX(-1) rotate(-30deg) translateY(-8px); }
  }

  /* Float kecil untuk aksen satu_bunga sisi kiri */
  @keyframes floatSmL {
    0%,100% { transform: rotate(-15deg) translateY(0px); }
    50%      { transform: rotate(-15deg) translateY(-5px); }
  }

  /* Float kecil untuk aksen satu_bunga sisi kanan */
  @keyframes floatSmR {
    0%,100% { transform: scaleX(-1) rotate(-15deg) translateY(0px); }
    50%      { transform: scaleX(-1) rotate(-15deg) translateY(-5px); }
  }

  /* ── ZOOM-IN BASE (semua flower mulai tidak tampak) ── */
  .flower-stalk-l, .flower-stalk-r,
  .flower-bot-l, .flower-bot-r,
  .flower-sm-l, .flower-sm-r {
    opacity: 0;
  }

  /* ── PER-CLASS ANIMATION ── */

  /* Tangkai kiri — miring kiri-atas */
  .flower-stalk-l {
    transform-origin: bottom center;
    animation:
      zoomIn 2s cubic-bezier(0.34,1.56,0.64,1) forwards,
      floatStalkL 6s ease-in-out 2.4s infinite;
  }

  /* Tangkai kanan — mirror kiri */
  .flower-stalk-r {
    transform-origin: bottom center;
    animation:
      zoomIn 2s cubic-bezier(0.34,1.56,0.64,1) forwards,
      floatStalkR 6s ease-in-out 2.6s infinite;
  }

  /* Bunga bawah kiri */
  .flower-bot-l {
    animation:
      zoomIn 1.8s cubic-bezier(0.34,1.56,0.64,1) forwards,
      floatNormal 4.5s ease-in-out 2.5s infinite;
  }

  /* Bunga bawah kanan */
  .flower-bot-r {
    transform: scaleX(-1);
    animation:
      zoomIn 1.8s cubic-bezier(0.34,1.56,0.64,1) forwards,
      floatMirrorX 4.5s ease-in-out 2.7s infinite;
  }

  /* Aksen kecil kiri */
  .flower-sm-l {
    transform-origin: center;
    animation:
      zoomIn 1.6s cubic-bezier(0.34,1.56,0.64,1) forwards,
      floatSmL 4s ease-in-out 2.8s infinite;
  }

  /* Aksen kecil kanan */
  .flower-sm-r {
    transform-origin: center;
    animation:
      zoomIn 1.6s cubic-bezier(0.34,1.56,0.64,1) forwards,
      floatSmR 4s ease-in-out 3s infinite;
  }

  /* ── KONTEN TEKS ── */
  .cover-fadein {
    opacity: 0;
    animation: zoomIn 1s cubic-bezier(0.16,1,0.3,1) forwards;
  }

  /* Cover scrollable meskipun body lock-scroll */
  #cover-screen {
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }
</style>