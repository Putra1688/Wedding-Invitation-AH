---
// src/components/taationSection.astro
const googleMapsUrl = "https://maps.google.com/?q=Pondok+Pesantren+Anwarul+Huda+Malang";
const qrCodeUrl = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(googleMapsUrl)}&color=4A3525&bgcolor=FAF6ED`;
---

<section id="lokasi" class="py-16 sm:py-24 px-4 bg-gradient-to-b from-[#F5EBE0]/80 via-[#FAF4EA]/85 to-[#EFE2CC]/80 relative overflow-hidden">
  <!-- Section Corner Ornaments (Pojok Layar / Screen Corners) -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden select-none z-0">
    <!-- Sudut Kiri Bawah Layar -->
    <div class="absolute -bottom-3 -left-3 pointer-events-none select-none z-0">
      <!-- 1. Paling Pojok (Outer Corner): tangkai_bunga_2.png (BEHIND sudut_bunga) -->
      <span class="absolute bottom-0 left-0 z-0" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="0">
        <img src="/image/tangkai_bunga_2.png" alt="Tangkai Bunga 2" class="w-32 sm:w-44 md:w-56 h-auto object-contain animate-sway drop-shadow-sm" />
      </span>

      <!-- 2. Bergeser ke Tengah: tangkai_bunga_3.png (BEHIND sudut_bunga) -->
      <span class="absolute bottom-2 left-16 sm:left-24 md:left-32 z-1" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="100">
        <img src="/image/tangkai_bunga_3.png" alt="Tangkai Bunga 3" class="w-28 sm:w-40 md:w-52 h-auto object-contain animate-sway drop-shadow-sm" />
      </span>

      <!-- 3. Lebih ke Tengah: satu_bunga_2.png (BEHIND sudut_bunga) -->
      <span class="absolute bottom-6 left-36 sm:left-52 md:left-64 z-2" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="200">
        <img src="/image/satu_bunga_2.png" alt="Satu Bunga 2" class="w-16 sm:w-22 md:w-28 h-auto object-contain animate-sway drop-shadow-md" />
      </span>

      <!-- 4. Paling Tengah: satu_bunga.png (BEHIND sudut_bunga) -->
      <span class="absolute bottom-10 left-52 sm:left-72 md:left-88 z-3" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="300">
        <img src="/image/satu_bunga.png" alt="Satu Bunga" class="w-18 sm:w-24 md:w-30 h-auto object-contain animate-sway drop-shadow-md" />
      </span>

      <!-- FRONT LAYER: sudut_bunga.png (Di Depan Semua Tangkai & Bunga) -->
      <span class="relative block z-10" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="0">
        <img 
          src="/image/sudut_bunga.png" 
          alt="Dekorasi Bunga Kiri Bawah" 
          class="w-36 sm:w-52 md:w-64 lg:w-80 h-auto object-contain drop-shadow-md opacity-95 scale-y-[-1]"
        />
      </span>
    </div>

    <!-- Sudut Kanan Bawah Layar -->
    <div class="absolute -bottom-3 -right-3 pointer-events-none select-none z-0">
      <!-- 1. Paling Pojok (Outer Corner): tangkai_bunga_2.png (BEHIND sudut_bunga) -->
      <span class="absolute bottom-0 right-0 z-0" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="0">
        <img src="/image/tangkai_bunga_2.png" alt="Tangkai Bunga 2" class="w-32 sm:w-44 md:w-56 h-auto object-contain animate-sway drop-shadow-sm scale-x-[-1]" />
      </span>

      <!-- 2. Bergeser ke Tengah: tangkai_bunga_3.png (BEHIND sudut_bunga) -->
      <span class="absolute bottom-2 right-16 sm:right-24 md:right-32 z-1" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="100">
        <img src="/image/tangkai_bunga_3.png" alt="Tangkai Bunga 3" class="w-28 sm:w-40 md:w-52 h-auto object-contain animate-sway drop-shadow-sm scale-x-[-1]" />
      </span>

      <!-- 3. Lebih ke Tengah: satu_bunga_2.png (BEHIND sudut_bunga) -->
      <span class="absolute bottom-6 right-36 sm:right-52 md:right-64 z-2" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="200">
        <img src="/image/satu_bunga_2.png" alt="Satu Bunga 2" class="w-16 sm:w-22 md:w-28 h-auto object-contain animate-sway drop-shadow-md scale-x-[-1]" />
      </span>

      <!-- 4. Paling Tengah: satu_bunga.png (BEHIND sudut_bunga) -->
      <span class="absolute bottom-10 right-52 sm:right-72 md:right-88 z-3" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="300">
        <img src="/image/satu_bunga.png" alt="Satu Bunga" class="w-18 sm:w-24 md:w-30 h-auto object-contain animate-sway drop-shadow-md scale-x-[-1]" />
      </span>

      <!-- FRONT LAYER: sudut_bunga.png (Di Depan Semua Tangkai & Bunga) -->
      <span class="relative block z-10" data-aos="zoom-in" data-aos-duration="2000" data-aos-delay="0">
        <img 
          src="/image/sudut_bunga.png" 
          alt="Dekorasi Bunga Kanan Bawah" 
          class="w-36 sm:w-52 md:w-64 lg:w-80 h-auto object-contain drop-shadow-md opacity-95 scale-x-[-1] scale-y-[-1]"
        />
      </span>
    </div>
  </div>

  <div class="max-w-4xl mx-auto text-center space-y-10 relative z-10">
    
    <!-- Section Header -->
    <div class="space-y-2">
      <span class="text-xs uppercase tracking-[0.3em] text-[#8C6D53] font-bold">Petunjuk Arah</span>
      <h2 class="font-serif-wedding text-3xl sm:text-5xl text-[#4A3525] font-semibold">Lokasi Acara & Barcode Maps</h2>
      <div class="w-20 h-0.5 bg-gradient-to-r from-transparent via-[#8C6D53] to-transparent mx-auto"></div>
    </div>

    <!-- Location Card with QR Code / Barcode -->
    <div class="p-8 sm:p-10 rounded-3xl bg-white/95 border border-[#E5DCC5] shadow-xl shadow-[#6E4F38]/10 grid md:grid-cols-2 gap-8 items-center text-center md:text-left relative overflow-hidden">
      <!-- Card Corner Ornaments (Bersih & Tidak Menutupi Teks/Barcode) -->
      <span class="absolute -top-5 -left-5 z-10" data-aos="zoom-in">
        <img src="/image/sudut_bunga.png" alt="Ornamen Bunga" class="w-24 sm:w-32 h-auto opacity-70 pointer-events-none select-none" />
      </span>
      <span class="absolute -bottom-5 -right-5 z-10" data-aos="zoom-in" data-aos-delay="150">
        <img src="/image/sudut_bunga.png" alt="Ornamen Bunga" class="w-24 sm:w-32 h-auto opacity-70 pointer-events-none select-none scale-x-[-1] scale-y-[-1]" />
      </span>
      
      <!-- QR Code / Barcode View -->
      <div class="flex flex-col items-center justify-center p-6 rounded-2xl bg-[#FAF6ED] border border-[#E5DCC5] space-y-3">
        <div class="p-3 bg-white rounded-xl shadow-md border border-[#E5DCC5]">
          <img 
            src={qrCodeUrl} 
            alt="Barcode QR Code Lokasi Maps" 
            class="w-44 h-44 object-contain rounded-lg"
            loading="lazy"
          />
        </div>
        <p class="text-xs text-[#7A5C43] font-semibold tracking-wide flex items-center gap-1 mt-2">
          <svg class="w-4 h-4 text-[#8C6D53]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
          </svg>
          Scan Barcode untuk Buka Rute Maps
        </p>
      </div>

      <!-- Address Details & Actions -->
      <div class="space-y-5">
        <div>
          <span class="inline-block px-3 py-1 rounded-full bg-[#FAF6ED] text-[#7A5C43] text-xs font-semibold uppercase tracking-wider border border-[#E5DCC5] mb-2">
            Lokasi Utama (Akad & Resepsi)
          </span>
          <h3 class="font-serif-wedding text-3xl text-[#4A3525] font-bold">Pondok Pesantren Anwarul Huda</h3>
          <p class="text-xs sm:text-sm text-[#594433] leading-relaxed mt-2 font-medium">
            Kota Malang, Jawa Timur
          </p>
        </div>

        <div class="w-full h-px bg-[#E5DCC5]"></div>

        <p class="text-xs text-[#8C6D53] italic">
          *Diharapkan untuk mematuhi arahan petunjuk jalan & area parkir yang disediakan oleh petugas lokasi.
        </p>

        <div>
          <a 
            href={googleMapsUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 w-full sm:w-auto px-8 py-3.5 rounded-full bg-gradient-to-r from-[#7A5C43] via-[#6E4F38] to-[#593E2B] text-white font-semibold text-sm shadow-md hover:shadow-lg transition-all duration-300 hover:scale-105"
          >
            <svg class="w-5 h-5 text-amber-200 fill-current" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <span>Buka di Google Maps</span>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

