---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import CoupleSection from '../components/CoupleSection.astro';
import EventSection from '../components/EventSection.astro';
import LocationSection from '../components/LocationSection.astro';
import GiftSection from '../components/GiftSection.astro';
import FooterSection from '../components/FooterSection.astro';

// Target tanggal pernikahan (contoh: 12 Desember 2026 09:00:00)
const weddingDate = "2026-12-12T09:00:00";
const groomName = "Arik";
const brideName = "Dhaniyah";
---

<Layout title={`Undangan Pernikahan - ${groomName} & ${brideName}`}>
  
  <!-- NAVBAR (FLOATING & HIDDEN UNTIL COVER IS UNLOCKED) -->
  <Navbar />

  <!-- COVER / HERO SECTION (FULLSCREEN & SCROLL LOCKED INITIALLY) -->
  <!-- PALETTE: KREM 50% (#FAF6ED) | PUTIH 30% (#FFFFFF) | COKLAT 20% (#4A3525, #6E4F38, #8C6D53) -->
  <section 
    id="cover-screen" 
    class="fixed inset-0 z-50 flex flex-col items-center justify-between p-3 sm:p-6 md:p-8 text-center overflow-hidden transition-all duration-1000 ease-in-out bg-gradient-to-b from-[#FAF6ED] via-[#F4EBD9] to-[#E9DDC3] border-b border-[#8C6D53]/20"
  >
    <!-- Background Soft Decorative Glows & Ornaments -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-white/70 via-transparent to-transparent pointer-events-none"></div>
    <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#8C6D53]/10 via-transparent to-transparent pointer-events-none"></div>

    <!-- Ornate Outer Frame -->
    <div class="absolute inset-3 sm:inset-5 border border-[#8C6D53]/25 rounded-2xl sm:rounded-3xl pointer-events-none flex flex-col justify-between p-2 sm:p-3">
      <div class="flex justify-between items-center text-[#8C6D53]/40 text-xs">
        <span>✦</span><span>✦</span>
      </div>
      <div class="flex justify-between items-center text-[#8C6D53]/40 text-xs">
        <span>✦</span><span>✦</span>
      </div>
    </div>

    <!-- Top Header & Salam -->
    <div class="relative z-10 pt-2 sm:pt-4 animate-fade-in shrink-0">
      <div class="flex justify-center items-center gap-2 sm:gap-3 text-[#7A5C43] mb-1 sm:mb-1.5">
        <div class="h-px w-8 sm:w-12 bg-gradient-to-r from-transparent to-[#8C6D53]"></div>
        <svg class="w-4 h-4 sm:w-5 sm:h-5 text-[#6E4F38] fill-current" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
        <div class="h-px w-8 sm:w-12 bg-gradient-to-l from-transparent to-[#8C6D53]"></div>
      </div>
      <p class="text-[11px] sm:text-xs md:text-sm tracking-[0.3em] text-[#7A5C43] uppercase font-semibold">
        Undangan Pernikahan
      </p>
    </div>

    <!-- Center Content: Names, Message & Countdown -->
    <div class="relative z-10 my-auto py-2 sm:py-3 max-w-2xl w-full flex flex-col items-center justify-center shrink">
      
      <!-- Greeting Message -->
      <p class="text-[#6E4F38] text-xs sm:text-sm font-serif-wedding italic mb-1">
        Assalamu’alaikum Warahmatullahi Wabarakatuh
      </p>
      <p class="text-[#594433] text-[11px] sm:text-xs md:text-sm max-w-md mx-auto leading-tight sm:leading-relaxed mb-3 sm:mb-4 font-light">
        Dengan penuh kebahagiaan dan rasa syukur. Kami mengundang untuk menyaksikan & mendoakan pernikahan anak kami:
      </p>

      <!-- Bride & Groom Names -->
      <h1 class="font-elegant-serif text-3xl sm:text-5xl md:text-6xl font-semibold text-[#4A3525] tracking-wide my-1 sm:my-2">
        {groomName} <span class="font-script text-[#8C6D53] text-3xl sm:text-5xl md:text-6xl mx-1 sm:mx-2 font-normal">&</span> {brideName}
      </h1>

      <!-- Guest Card (Putih 30%) -->
      <div class="mt-3 mb-3 sm:mt-4 sm:mb-4 p-2.5 sm:p-3.5 rounded-xl sm:rounded-2xl bg-white shadow-lg shadow-[#6E4F38]/5 border border-[#E8DFC8] max-w-xs sm:max-w-sm w-full">
        <span class="inline-block px-2.5 py-0.5 rounded-full bg-[#FAF6ED] text-[#7A5C43] text-[10px] sm:text-[11px] font-semibold uppercase tracking-wider border border-[#E5DCC5] mb-1">
          Kepada Yth. Bapak/Ibu/Saudara/i
        </span>
        <p id="guest-name" class="text-base sm:text-lg md:text-xl font-bold text-[#4A3525] tracking-wide">
          Tamu Undangan
        </p>
      </div>

      <!-- COUNTDOWN TIMER (Krem 50% & Putih 30% with Coklat 20% Text) -->
      <div class="w-full max-w-xs sm:max-w-md my-1 sm:my-2">
        <p class="text-[10px] sm:text-xs uppercase tracking-[0.2em] text-[#7A5C43] mb-2 font-semibold">Menghitung Hari Pelaksanaan</p>
        <div class="grid grid-cols-4 gap-1.5 sm:gap-3 text-center">
          <div class="p-2 sm:p-3 rounded-xl sm:rounded-2xl bg-white/90 border border-[#E5DCC5] shadow-md shadow-[#6E4F38]/5">
            <span id="cd-days" class="block font-serif-wedding text-xl sm:text-3xl font-bold text-[#4A3525]">00</span>
            <span class="text-[9px] sm:text-xs text-[#8C6D53] font-medium uppercase tracking-widest mt-0.5 block">Hari</span>
          </div>
          <div class="p-2 sm:p-3 rounded-xl sm:rounded-2xl bg-white/90 border border-[#E5DCC5] shadow-md shadow-[#6E4F38]/5">
            <span id="cd-hours" class="block font-serif-wedding text-xl sm:text-3xl font-bold text-[#4A3525]">00</span>
            <span class="text-[9px] sm:text-xs text-[#8C6D53] font-medium uppercase tracking-widest mt-0.5 block">Jam</span>
          </div>
          <div class="p-2 sm:p-3 rounded-xl sm:rounded-2xl bg-white/90 border border-[#E5DCC5] shadow-md shadow-[#6E4F38]/5">
            <span id="cd-minutes" class="block font-serif-wedding text-xl sm:text-3xl font-bold text-[#4A3525]">00</span>
            <span class="text-[9px] sm:text-xs text-[#8C6D53] font-medium uppercase tracking-widest mt-0.5 block">Menit</span>
          </div>
          <div class="p-2 sm:p-3 rounded-xl sm:rounded-2xl bg-white/90 border border-[#E5DCC5] shadow-md shadow-[#6E4F38]/5">
            <span id="cd-seconds" class="block font-serif-wedding text-xl sm:text-3xl font-bold text-[#4A3525]">00</span>
            <span class="text-[9px] sm:text-xs text-[#8C6D53] font-medium uppercase tracking-widest mt-0.5 block">Detik</span>
          </div>
        </div>
      </div>

    </div>

    <!-- CTA Button to Unlock Scroll (Coklat 20% Primary Accent) -->
    <div class="relative z-10 pb-2 sm:pb-4 shrink-0">
      <button 
        id="btn-open-invitation"
        class="group relative inline-flex items-center gap-2.5 sm:gap-3 px-6 py-2.5 sm:px-8 sm:py-3.5 rounded-full bg-gradient-to-r from-[#7A5C43] via-[#6E4F38] to-[#593E2B] text-white font-semibold text-xs sm:text-sm md:text-base tracking-wide shadow-[0_10px_25px_rgba(110,79,56,0.25)] hover:shadow-[0_15px_30px_rgba(110,79,56,0.4)] transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer"
      >
        <svg class="w-4 h-4 sm:w-5 sm:h-5 text-amber-100 transition-transform duration-300 group-hover:rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        <span>Lihat Undangan</span>
        <svg class="w-4 h-4 text-amber-100 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </button>
      <p class="text-[10px] sm:text-[11px] text-[#8C6D53] mt-1.5 font-medium">Klik tombol di atas untuk membuka seluruh isi undangan</p>
    </div>
  </section>

  <!-- MAIN CONTENT SECTION (ACCESSIBLE AFTER UNLOCKING COVER) -->
  <main id="main-content" class="min-h-screen bg-[#FAF6ED] text-[#4A3525] relative">
    
    <!-- 1. Acara Pernikahan & Mempelai -->
    <CoupleSection groomName={groomName} brideName={brideName} />

    <!-- 3. Rangkaian Acara (Akad & Resepsi) -->
    <EventSection />

    <!-- 4. Lokasi & Barcode Maps -->
    <LocationSection />

    <!-- 5. Amplop Digital & Gift -->
    <!-- <GiftSection /> -->

    <!-- 6. Footer & Ucapan Terima Kasih -->
    <FooterSection groomName={groomName} brideName={brideName} />

  </main>
</Layout>

<script is:inline define:vars={{ weddingDate }}>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Ambil Nama Tamu dari URL Parameter (?to=Nama+Tamu)
    const urlParams = new URLSearchParams(window.location.search);
    const guestParam = urlParams.get('to');
    const guestNameEl = document.getElementById('guest-name');
    if (guestParam && guestNameEl) {
      guestNameEl.textContent = guestParam;
    }

    // 2. Countdown Timer Logic
    const targetTime = new Date(weddingDate).getTime();

    function updateCountdown() {
      const now = new Date().getTime();
      const difference = targetTime - now;

      if (difference <= 0) {
        document.getElementById('cd-days').textContent = '00';
        document.getElementById('cd-hours').textContent = '00';
        document.getElementById('cd-minutes').textContent = '00';
        document.getElementById('cd-seconds').textContent = '00';
        return;
      }

      const days = Math.floor(difference / (1000 * 60 * 60 * 24));
      const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((difference % (1000 * 60)) / 1000);

      document.getElementById('cd-days').textContent = days < 10 ? '0' + days : days;
      document.getElementById('cd-hours').textContent = hours < 10 ? '0' + hours : hours;
      document.getElementById('cd-minutes').textContent = minutes < 10 ? '0' + minutes : minutes;
      document.getElementById('cd-seconds').textContent = seconds < 10 ? '0' + seconds : seconds;
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);

    // 3. Audio & Navbar Unlock Logic
    const btnOpen = document.getElementById('btn-open-invitation');
    const coverScreen = document.getElementById('cover-screen');
    const mainContent = document.getElementById('main-content');
    const navbar = document.getElementById('navbar');
    const weddingAudio = document.getElementById('wedding-audio');
    const btnAudio = document.getElementById('btn-audio');
    const iconPlaying = document.getElementById('icon-music-playing');
    const iconPaused = document.getElementById('icon-music-paused');

    let isAudioPlaying = false;

    function toggleAudio() {
      if (!weddingAudio) return;
      if (isAudioPlaying) {
        weddingAudio.pause();
        isAudioPlaying = false;
        if (iconPlaying) iconPlaying.classList.add('hidden');
        if (iconPaused) iconPaused.classList.remove('hidden');
      } else {
        weddingAudio.play().then(() => {
          isAudioPlaying = true;
          if (iconPlaying) iconPlaying.classList.remove('hidden');
          if (iconPaused) iconPaused.classList.add('hidden');
        }).catch(err => console.log('Audio autoplay policy:', err));
      }
    }

    if (btnAudio) {
      btnAudio.addEventListener('click', toggleAudio);
    }

    if (btnOpen && coverScreen) {
      btnOpen.addEventListener('click', () => {
        // Unlock body scroll
        document.body.classList.remove('lock-scroll');

        // Smooth transition out cover screen
        coverScreen.classList.add('opacity-0', 'pointer-events-none', '-translate-y-full');

        // Tampilkan & aktifkan Navbar setelah cover dibuka!
        if (navbar) {
          navbar.classList.remove('hidden');
          setTimeout(() => {
            navbar.classList.remove('opacity-0');
          }, 100);
        }

        // Putar audio secara otomatis saat undangan dibuka
        toggleAudio();

        // Scroll to main content smoothly
        if (mainContent) {
          mainContent.scrollIntoView({ behavior: 'smooth' });
        }

        // Hide cover screen completely after transition completes
        setTimeout(() => {
          coverScreen.style.display = 'none';
        }, 1000);
      });
    }
  });
</script>