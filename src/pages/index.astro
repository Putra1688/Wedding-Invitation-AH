---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import CoverSection from '../components/CoverSection.astro';
import CoupleSection from '../components/CoupleSection.astro';
import EventSection from '../components/EventSection.astro';
import LocationSection from '../components/LocationSection.astro';
import GiftSection from '../components/GiftSection.astro';
import FooterSection from '../components/FooterSection.astro';

// Target tanggal pernikahan (contoh: 12 Desember 2026 09:00:00)
const weddingDate = "2026-11-15T18:30:00";
const groomName = "Arik";
const brideName = "Dania";
---

<Layout title={`Undangan Pernikahan - ${groomName} & ${brideName}`}>
  
  <!-- NAVBAR (FLOATING & HIDDEN UNTIL COVER IS UNLOCKED) -->
  <Navbar />

  <!-- COVER / HERO SECTION (MODULAR COMPONENT) -->
  <CoverSection groomName={groomName} brideName={brideName} />

  <!-- MAIN CONTENT SECTION (ACCESSIBLE AFTER UNLOCKING COVER) -->
  <main id="main-content" class="hidden min-h-screen bg-gradient-to-b from-[#FAF4EA]/70 via-[#F3E7D3]/50 to-[#EADBC4]/70 backdrop-blur-[1px] relative">
    
    <!-- 1. Acara Pernikahan & Mempelai -->
    <CoupleSection groomName={groomName} brideName={brideName} />

    <!-- 3. Rangkaian Acara (Akad & Resepsi) -->
    <EventSection />

    <!-- 4. Lokasi & Barcode Maps -->
    <LocationSection />

    <!-- 5. Amplop Digital & Gift -->
    <!-- <GiftSection /> -->

    <!-- 6. Footer & Ucapan Terima Kasih -->
    <FooterSection groomName={groomName} brideName={brideName} />

  </main>
</Layout>

<script is:inline define:vars={{ weddingDate }}>
  document.addEventListener('DOMContentLoaded', () => {
    // Audio & Navbar Unlock Logic
    const btnOpen = document.getElementById('btn-open-invitation');
    const coverScreen = document.getElementById('cover-screen');
    const mainContent = document.getElementById('main-content');
    const navbar = document.getElementById('navbar');
    const weddingAudio = document.getElementById('wedding-audio');
    const btnAudio = document.getElementById('btn-audio');
    const iconPlaying = document.getElementById('icon-music-playing');
    const iconPaused = document.getElementById('icon-music-paused');

    let isAudioPlaying = false;

    function toggleAudio() {
      if (!weddingAudio) return;
      if (isAudioPlaying) {
        weddingAudio.pause();
        isAudioPlaying = false;
        if (iconPlaying) iconPlaying.classList.add('hidden');
        if (iconPaused) iconPaused.classList.remove('hidden');
      } else {
        weddingAudio.play().then(() => {
          isAudioPlaying = true;
          if (iconPlaying) iconPlaying.classList.remove('hidden');
          if (iconPaused) iconPaused.classList.add('hidden');
        }).catch(err => console.log('Audio autoplay policy:', err));
      }
    }

    if (btnAudio) {
      btnAudio.addEventListener('click', toggleAudio);
    }

    if (btnOpen && coverScreen) {
      btnOpen.addEventListener('click', () => {
        document.body.classList.remove('lock-scroll');

        if (mainContent) {
          mainContent.classList.remove('hidden');
        }

        coverScreen.classList.add('opacity-0', 'pointer-events-none', '-translate-y-full');

        if (navbar) {
          navbar.classList.remove('hidden');
          setTimeout(() => {
            navbar.classList.remove('opacity-0');
          }, 100);
        }

        toggleAudio();

        setTimeout(() => {
          if (typeof AOS !== 'undefined') {
            AOS.init({
              duration: 2000,
              easing: 'ease-out-cubic',
              once: true,
              offset: 20,
              startEvent: 'DOMContentLoaded',
              anchorPlacement: 'top-bottom',
            });
            AOS.refreshHard();
          }
        }, 200);

        if (mainContent) {
          mainContent.scrollIntoView({ behavior: 'smooth' });
        }

        setTimeout(() => {
          coverScreen.style.display = 'none';
        }, 1000);
      });
    }
  });
</script>